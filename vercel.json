{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm --prefix front-end ci && VITE_API_URL=/api VITE_API_ACCESS_TOKEN= npm --prefix front-end run build -- --outDir ../web-build --emptyOutDir",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{front-end/**,back-end/tests/**,back-end/**/__pycache__/**,public/**,.venv/**,**/.env,**/.env.*,artifacts/**}"
    }
  },
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
